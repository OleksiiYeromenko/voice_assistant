# Voice Assistant — systemd service (UI mode / PyQt6 fullscreen)
#
# Runs with wake word + 800x480 touch display.
# Requires a graphical session (X11 auto-login on RPi).
#
# Install:  va install --ui       (auto-detects project dir and user)
#       OR  manually: edit @@…@@ placeholders, then cp to /etc/systemd/system/
#
# Logs:     journalctl -u voice-assistant-ui -f
# Status:   systemctl status voice-assistant-ui
#
# NOTE: Only enable ONE of voice-assistant.service or voice-assistant-ui.service,
#       not both — they share the same audio devices and ALSA mic.

[Unit]
Description=Voice Assistant UI (Poondyk)
Documentation=file://@@PROJECT_DIR@@/README.md
After=network-online.target sound.target ollama.service graphical.target
Wants=network-online.target ollama.service
Requires=graphical.target

[Service]
Type=simple
User=@@USER@@
Group=@@USER@@

WorkingDirectory=@@PROJECT_DIR@@

ExecStart=@@UV@@ run python -m src.main --ui

Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# X11 display — required for PyQt6
Environment="HOME=@@HOME@@"
Environment="DISPLAY=:0"
Environment="QT_QPA_PLATFORM=xcb"
Environment="PATH=@@HOME@@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/@@UID@@"

# Cloud API keys
EnvironmentFile=-@@PROJECT_DIR@@/.env
EnvironmentFile=-@@PROJECT_DIR@@/.env.local

# Resource limits
MemoryMax=8G
CPUQuota=300%

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@@PROJECT_DIR@@/data
ReadWritePaths=@@PROJECT_DIR@@/memory
ReadWritePaths=@@PROJECT_DIR@@/tts_output
ReadWritePaths=@@PROJECT_DIR@@/stt_output
ProtectHome=no
PrivateTmp=yes

SupplementaryGroups=audio video render input

[Install]
WantedBy=graphical.target

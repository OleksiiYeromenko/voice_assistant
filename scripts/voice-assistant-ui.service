# Voice Assistant — systemd service (UI mode / PyQt6 fullscreen)
#
# Runs with wake word + 800x480 touch display.
# Requires a graphical session (X11 auto-login on RPi).
#
# Install:  sudo cp scripts/voice-assistant-ui.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now voice-assistant-ui
#
# Logs:     journalctl -u voice-assistant-ui -f
# Status:   systemctl status voice-assistant-ui
#
# NOTE: Only enable ONE of voice-assistant.service or voice-assistant-ui.service,
#       not both — they share the same audio devices and ALSA mic.

[Unit]
Description=Voice Assistant UI (Poondyk)
Documentation=file:///home/pi/Projects/voice_assistant/README.md
After=network-online.target sound.target ollama.service graphical.target
Wants=network-online.target ollama.service
Requires=graphical.target

[Service]
Type=simple
User=pi
Group=pi

WorkingDirectory=/home/pi/Projects/voice_assistant

ExecStart=/home/pi/.local/bin/uv run python -m src.main --ui

Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# X11 display — required for PyQt6
Environment="HOME=/home/pi"
Environment="DISPLAY=:0"
Environment="QT_QPA_PLATFORM=xcb"
Environment="PATH=/home/pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/1000"

# Cloud API keys
EnvironmentFile=-/home/pi/Projects/voice_assistant/.env
EnvironmentFile=-/home/pi/Projects/voice_assistant/.env.local

# Resource limits
MemoryMax=8G
CPUQuota=300%

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/pi/Projects/voice_assistant/data
ReadWritePaths=/home/pi/Projects/voice_assistant/memory
ReadWritePaths=/home/pi/Projects/voice_assistant/tts_output
ReadWritePaths=/home/pi/Projects/voice_assistant/stt_output
ProtectHome=no
PrivateTmp=yes

SupplementaryGroups=audio video render input

[Install]
WantedBy=graphical.target
